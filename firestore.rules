rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Orders collection
    match /orders/{orderId} {
      // Allow read access if user knows the order ID
      // (Useful for order confirmation pages without requiring auth)
      allow read: if true;
      
      // Allow write only via Admin SDK (server-side)
      // Client-side should never create orders directly
      allow write: if false;
    }
    
    // Products collection (if you store products in Firestore)
    match /products/{productId} {
      // Allow public read access for product catalog
      allow read: if true;
      
      // Allow write only via Admin SDK
      allow write: if false;
    }
    
    // Example: Users collection (if you implement user profiles)
    match /users/{userId} {
      // Allow users to read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to write their own profile
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
